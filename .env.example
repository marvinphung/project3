# Localhost-only defaults. Copy to .env and replace values before starting.
POSTGRES_USER=footballpulse
POSTGRES_PASSWORD=change-me-local-postgres
POSTGRES_DB=footballpulse
POSTGRES_HOST_PORT=5432

REDIS_PASSWORD=change-me-local-redis
REDIS_HOST_PORT=6379

MONGODB_HOST_PORT=27017
KAFKA_HOST_PORT=29092
MOCK_NEWS_SOURCE_HOST_PORT=18080

# Application runtime configuration. Replace both required secret placeholders
# with at least 32 characters before starting an application service.
FOOTBALLPULSE_ENVIRONMENT=local
FOOTBALLPULSE_LOG_LEVEL=INFO
FOOTBALLPULSE_POSTGRES_DSN=postgresql+psycopg://footballpulse:change-me-local-postgres@postgres:5432/footballpulse
FOOTBALLPULSE_MONGODB_DSN=mongodb://mongodb:27017/?replicaSet=rs0
FOOTBALLPULSE_REDIS_DSN=redis://:change-me-local-redis@redis:6379/0
FOOTBALLPULSE_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
FOOTBALLPULSE_JWT_SECRET=change-me-before-api-phase-32-characters
FOOTBALLPULSE_INTERNAL_API_TOKEN=change-me-before-api-phase-32-characters
FOOTBALLPULSE_AI_PROVIDER=mock
FOOTBALLPULSE_OPENAI_API_KEY=
FOOTBALLPULSE_OPENROUTER_API_KEY=
