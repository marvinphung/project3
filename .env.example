# Shared local runtime defaults. Copy to .env and override locally.
FOOTBALLPULSE_ENV=local
FOOTBALLPULSE_LOG_LEVEL=INFO
FOOTBALLPULSE_TIMEZONE=Asia/Ho_Chi_Minh

# Local-only dependency ports and development credentials.
FOOTBALLPULSE_KAFKA_PORT=19092
FOOTBALLPULSE_MONGODB_PORT=27117
FOOTBALLPULSE_MONGODB_DB=footballpulse_v2
FOOTBALLPULSE_MONGODB_URL=mongodb://127.0.0.1:27117/?replicaSet=rs0&directConnection=true
FOOTBALLPULSE_FETCH_ARTIFACT_ROOT=.local-data/fetch-artifacts
FOOTBALLPULSE_AI_BATCH_ROOT=.footballpulse/ai-batches
FOOTBALLPULSE_POSTGRES_PORT=15432
FOOTBALLPULSE_REDIS_PORT=6379
FOOTBALLPULSE_CRAWLER_PORT=8011
FOOTBALLPULSE_API_PORT=8000
FOOTBALLPULSE_AI_PORT=8002
FOOTBALLPULSE_FRONTEND_PORT=8443
FOOTBALLPULSE_CRAWL_MAX_ARTICLES=10
FOOTBALLPULSE_BROWSER_FALLBACK=true
FOOTBALLPULSE_POSTGRES_DB=footballpulse_v2
FOOTBALLPULSE_POSTGRES_USER=footballpulse
FOOTBALLPULSE_POSTGRES_PASSWORD=footballpulse_v2_local
FOOTBALLPULSE_REDIS_PASSWORD=footballpulse_local_only

# Development-only service tokens. Replace them in any shared environment.
FOOTBALLPULSE_CRAWLER_ADMIN_TOKEN=footballpulse_admin_local_only
FOOTBALLPULSE_CRAWLER_INTERNAL_TOKEN=footballpulse_internal_local_only
FOOTBALLPULSE_API_ADMIN_TOKEN=local-admin-token
FOOTBALLPULSE_API_JWT_SECRET=local-jwt-secret-change-me-0123456789
FOOTBALLPULSE_API_ADMIN_USERNAME=admin
FOOTBALLPULSE_API_ADMIN_PASSWORD=footballpulse-admin
FOOTBALLPULSE_AI_INTERNAL_TOKEN=local-ai-internal-token

# Optional Kaggle AI batch settings. Set credentials only in the untracked .env.
FOOTBALLPULSE_KAGGLE_DATASET_SLUG=your-user/footballpulse-ai-batches
FOOTBALLPULSE_KAGGLE_KERNEL_SLUG=your-user/footballpulse-ai-enrichment
FOOTBALLPULSE_KAGGLE_MODEL_SOURCE=qwen-lm/qwen-3/transformers/0.6b/1
KAGGLE_USERNAME=
KAGGLE_API_TOKEN=

# Production path uses Kaggle Qwen.
FOOTBALLPULSE_AI_PROVIDER=kaggle
FOOTBALLPULSE_AI_ALLOW_LOCAL_FALLBACK=false
FOOTBALLPULSE_LOCAL_MODEL_PATH=
FOOTBALLPULSE_LOCAL_MODEL_SHA256=
FOOTBALLPULSE_LOCAL_MODEL_VERSION=Qwen3-4B-Instruct-GGUF-Q4_K_M
FOOTBALLPULSE_LOCAL_MODEL_N_CTX=8192
FOOTBALLPULSE_LOCAL_MODEL_N_THREADS=8

# Production intelligence models (downloaded once into the Docker model cache).
FOOTBALLPULSE_ENTITY_PROVIDER=gliner
FOOTBALLPULSE_GLINER_MODEL=fastino/gliner2-large-v1
NER_MODEL_NAME=fastino/gliner2-large-v1
NER_DEVICE=cpu
ENTITY_EXTRACTION_MIN_CONFIDENCE=0.5
FOOTBALLPULSE_EMBEDDING_PROVIDER=bge
FOOTBALLPULSE_BGE_MODEL=BAAI/bge-small-en-v1.5
FOOTBALLPULSE_INTELLIGENCE_BATCH_SIZE=50
FOOTBALLPULSE_INTELLIGENCE_POLL_SECONDS=30
FOOTBALLPULSE_ENRICHMENT_BATCH_SIZE=10
FOOTBALLPULSE_ENRICHMENT_POLL_SECONDS=30
FOOTBALLPULSE_PROJECTOR_POLL_SECONDS=60

# Version 2 local pipeline.
FOOTBALLPULSE_V2_KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:19092
FOOTBALLPULSE_V2_MONGODB_URL="mongodb://127.0.0.1:27117/?replicaSet=rs0&directConnection=true"
FOOTBALLPULSE_V2_MONGODB_DB=footballpulse_v2
FOOTBALLPULSE_V2_POSTGRES_URL=postgresql+psycopg://footballpulse:footballpulse_v2_local@127.0.0.1:15432/footballpulse_v2
FOOTBALLPULSE_V2_CRAWL_CANDIDATE_LIMIT=500
FOOTBALLPULSE_V2_SCHEDULED_FETCH_LIMIT=100
FOOTBALLPULSE_V2_BOOTSTRAP_FETCH_LIMIT=500
FOOTBALLPULSE_V2_GLOBAL_FETCH_CONCURRENCY=10
FOOTBALLPULSE_V2_PER_DOMAIN_FETCH_CONCURRENCY=2
FOOTBALLPULSE_V2_ENTITY_WORKERS=6
FOOTBALLPULSE_V2_PUBLISH_WORKERS=6
FOOTBALLPULSE_V2_PROCESS_LIMIT=20
FOOTBALLPULSE_V2_PUBLISH_LIMIT=50
FOOTBALLPULSE_V2_CRAWL_SCHEDULE="*/30 * * * *"
FOOTBALLPULSE_V2_PROCESS_SCHEDULE="*/30 * * * *"
FOOTBALLPULSE_V2_PUBLISH_SCHEDULE="*/15 * * * *"
FOOTBALLPULSE_V2_RECONCILE_SCHEDULE="0 3 * * *"

# Supabase production read model. Fill before remote integration/deployment.
SUPABASE_DATABASE_URL=
SUPABASE_PROJECT_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=

# Render and Vercel.
RENDER_BACKEND_PUBLIC_URL=
VITE_API_BASE_URL=
VITE_BACKEND_API_URL=
VITE_CRAWLER_API_BASE_URL=

# Airflow v2 commands.
FOOTBALLPULSE_CRAWL_COMMAND=python -m footballpulse_pipeline crawl
FOOTBALLPULSE_PROCESS_COMMAND=python -m footballpulse_pipeline process
FOOTBALLPULSE_PUBLISH_COMMAND=python -m footballpulse_pipeline publish
FOOTBALLPULSE_RECONCILE_COMMAND=python -m footballpulse_pipeline reconcile
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=false

# Kaggle v2 local artifact policy.
FOOTBALLPULSE_KAGGLE_ACCELERATOR=NvidiaTeslaT4
FOOTBALLPULSE_KAGGLE_UPLOAD_ALL_UNENRICHED=true
FOOTBALLPULSE_KAGGLE_LOCAL_ARTIFACT_ROOT=.tmp/kaggle-runs
