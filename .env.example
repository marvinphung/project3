# FootballPulse v2 local/runtime configuration.
# Copy this file to .env and fill the blank secrets locally.

# Shared runtime.
FOOTBALLPULSE_ENV=local
FOOTBALLPULSE_LOG_LEVEL=INFO
FOOTBALLPULSE_TIMEZONE=UTC

# Local infrastructure.
FOOTBALLPULSE_KAFKA_PORT=19092
FOOTBALLPULSE_MONGODB_PORT=27117
FOOTBALLPULSE_MONGODB_DB=footballpulse_v2
FOOTBALLPULSE_MONGODB_URL="mongodb://127.0.0.1:27117/?replicaSet=rs0&directConnection=true"
FOOTBALLPULSE_V2_KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:19092
FOOTBALLPULSE_V2_MONGODB_URL="mongodb://127.0.0.1:27117/?replicaSet=rs0&directConnection=true"
FOOTBALLPULSE_V2_MONGODB_DB=footballpulse_v2

# Local service ports.
FOOTBALLPULSE_CRAWLER_PORT=8011
FOOTBALLPULSE_API_PORT=8000
FOOTBALLPULSE_ENTITIES_EXTRACTION_PORT=8002
FOOTBALLPULSE_FRONTEND_PORT=8443
FOOTBALLPULSE_REDIS_PORT=6379

# Local service credentials.
FOOTBALLPULSE_REDIS_PASSWORD=footballpulse_local_only
FOOTBALLPULSE_CRAWLER_ADMIN_TOKEN=footballpulse_admin_local_only
FOOTBALLPULSE_CRAWLER_INTERNAL_TOKEN=footballpulse_internal_local_only
FOOTBALLPULSE_API_ADMIN_TOKEN=local-admin-token
FOOTBALLPULSE_API_JWT_SECRET=local-jwt-secret-change-me-0123456789
FOOTBALLPULSE_API_ADMIN_USERNAME=admin
FOOTBALLPULSE_API_ADMIN_PASSWORD=footballpulse-admin

# Crawler runtime.
FOOTBALLPULSE_FETCH_ARTIFACT_ROOT=.local-data/fetch-artifacts
FOOTBALLPULSE_BROWSER_FALLBACK=true
FOOTBALLPULSE_CRAWL_MAX_ARTICLES=100

# Entities extraction runtime.
FOOTBALLPULSE_ENTITY_PROVIDER=gliner
FOOTBALLPULSE_GLINER_MODEL=fastino/gliner2-large-v1
NER_MODEL_NAME=fastino/gliner2-large-v1
NER_DEVICE=cpu
ENTITY_EXTRACTION_MIN_CONFIDENCE=0.95

# Content summary LLM runtime.
# Supported providers: openai, gemini. Leave provider/key blank to use the mock client.
FOOTBALLPULSE_LLM_PROVIDER=
FOOTBALLPULSE_LLM_MODEL=
FOOTBALLPULSE_LLM_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=

# Pipeline limits and schedules.
FOOTBALLPULSE_V2_CRAWL_CANDIDATE_LIMIT=500
FOOTBALLPULSE_V2_SCHEDULED_FETCH_LIMIT=100
FOOTBALLPULSE_V2_BOOTSTRAP_FETCH_LIMIT=500
FOOTBALLPULSE_V2_GLOBAL_FETCH_CONCURRENCY=10
FOOTBALLPULSE_V2_PER_DOMAIN_FETCH_CONCURRENCY=2
FOOTBALLPULSE_V2_PROCESS_LIMIT=100
FOOTBALLPULSE_V2_PUBLISH_LIMIT=100
FOOTBALLPULSE_V2_CRAWL_SCHEDULE="*/30 * * * *"
FOOTBALLPULSE_V2_PROCESS_SCHEDULE="*/30 * * * *"
FOOTBALLPULSE_V2_PUBLISH_SCHEDULE="*/15 * * * *"

# Airflow command adapters.
FOOTBALLPULSE_CRAWL_COMMAND="python -m footballpulse_pipeline crawl"
FOOTBALLPULSE_PROCESS_COMMAND="python -m footballpulse_pipeline process"
FOOTBALLPULSE_SUMMARY_COMMAND="python -m footballpulse_pipeline summary"
FOOTBALLPULSE_PUBLISH_COMMAND="python -m footballpulse_pipeline publish"
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=false

# Supabase/PostgreSQL serving target.
# Backend API and publisher require this target, both locally and in production.
# Prefer SUPABASE_DATABASE_URL if available; otherwise use host/user/password fields.
SUPABASE_DATABASE_URL=
SUPABASE_PROJECT_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=

# Frontend API routing.
# Local frontend: VITE_API_BASE_URL=http://localhost:8000
# Vercel frontend: VITE_API_BASE_URL=<Render backend public URL>
RENDER_BACKEND_PUBLIC_URL=
VITE_API_BASE_URL=
VITE_CRAWLER_API_BASE_URL=
