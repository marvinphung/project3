# Shared local runtime defaults. Copy to .env and override locally.
FOOTBALLPULSE_ENV=production
FOOTBALLPULSE_LOG_LEVEL=INFO
FOOTBALLPULSE_TIMEZONE=Asia/Ho_Chi_Minh

# Local-only dependency ports and development credentials.
FOOTBALLPULSE_KAFKA_PORT=9092
FOOTBALLPULSE_MONGODB_PORT=27017
FOOTBALLPULSE_MONGODB_DB=footballpulse
FOOTBALLPULSE_MONGODB_URL=mongodb://127.0.0.1:27017/?replicaSet=rs0&directConnection=true
FOOTBALLPULSE_FETCH_ARTIFACT_ROOT=.local-data/fetch-artifacts
FOOTBALLPULSE_AI_BATCH_ROOT=.footballpulse/ai-batches
FOOTBALLPULSE_POSTGRES_PORT=5432
FOOTBALLPULSE_REDIS_PORT=6379
FOOTBALLPULSE_CRAWLER_PORT=8011
FOOTBALLPULSE_API_PORT=8000
FOOTBALLPULSE_AI_PORT=8002
FOOTBALLPULSE_FRONTEND_PORT=8443
FOOTBALLPULSE_CRAWL_MAX_ARTICLES=10
FOOTBALLPULSE_BROWSER_FALLBACK=true
FOOTBALLPULSE_POSTGRES_DB=footballpulse
FOOTBALLPULSE_POSTGRES_USER=footballpulse
FOOTBALLPULSE_POSTGRES_PASSWORD=footballpulse_local_only
FOOTBALLPULSE_REDIS_PASSWORD=footballpulse_local_only

# Development-only service tokens. Replace them in any shared environment.
FOOTBALLPULSE_CRAWLER_ADMIN_TOKEN=footballpulse_admin_local_only
FOOTBALLPULSE_CRAWLER_INTERNAL_TOKEN=footballpulse_internal_local_only
FOOTBALLPULSE_API_ADMIN_TOKEN=local-admin-token
FOOTBALLPULSE_API_JWT_SECRET=local-jwt-secret-change-me-0123456789
FOOTBALLPULSE_API_ADMIN_USERNAME=admin
FOOTBALLPULSE_API_ADMIN_PASSWORD=footballpulse-admin
FOOTBALLPULSE_AI_INTERNAL_TOKEN=local-ai-internal-token

# Optional Kaggle AI batch settings. Set credentials only in the untracked .env.
FOOTBALLPULSE_KAGGLE_DATASET_SLUG=your-user/footballpulse-ai-batches
FOOTBALLPULSE_KAGGLE_KERNEL_SLUG=your-user/footballpulse-ai-enrichment
FOOTBALLPULSE_KAGGLE_MODEL_SOURCE=qwen-lm/qwen-3/transformers/0.6b/1
KAGGLE_USERNAME=
KAGGLE_API_TOKEN=

# Production path uses Kaggle Qwen. Mock remains available only for tests.
FOOTBALLPULSE_AI_PROVIDER=kaggle
FOOTBALLPULSE_AI_DETERMINISTIC_OFFLINE=false
FOOTBALLPULSE_AI_ALLOW_LOCAL_FALLBACK=false
FOOTBALLPULSE_AI_ALLOW_MOCK=false
FOOTBALLPULSE_LOCAL_MODEL_PATH=
FOOTBALLPULSE_LOCAL_MODEL_SHA256=
FOOTBALLPULSE_LOCAL_MODEL_VERSION=Qwen3-4B-Instruct-GGUF-Q4_K_M
FOOTBALLPULSE_LOCAL_MODEL_N_CTX=8192
FOOTBALLPULSE_LOCAL_MODEL_N_THREADS=8
FOOTBALLPULSE_MOCK_FIXTURE_PATH=

# Production intelligence models (downloaded once into the Docker model cache).
FOOTBALLPULSE_ENTITY_PROVIDER=gliner
FOOTBALLPULSE_GLINER_MODEL=urchade/gliner_small-v2.1
FOOTBALLPULSE_EMBEDDING_PROVIDER=bge
FOOTBALLPULSE_BGE_MODEL=BAAI/bge-small-en-v1.5
FOOTBALLPULSE_INTELLIGENCE_BATCH_SIZE=50
FOOTBALLPULSE_INTELLIGENCE_POLL_SECONDS=30
FOOTBALLPULSE_ENRICHMENT_BATCH_SIZE=10
FOOTBALLPULSE_ENRICHMENT_POLL_SECONDS=30
FOOTBALLPULSE_PROJECTOR_POLL_SECONDS=60
