{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "ArticleEnrichedPayload": {
      "additionalProperties": false,
      "properties": {
        "article_version_id": {
          "format": "uuid",
          "title": "Article Version Id",
          "type": "string"
        },
        "input_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Input Hash",
          "type": "string"
        },
        "enrichment_id": {
          "format": "uuid",
          "title": "Enrichment Id",
          "type": "string"
        },
        "validation_status": {
          "enum": [
            "VALIDATED",
            "PARTIAL"
          ],
          "title": "Validation Status",
          "type": "string"
        },
        "valid_claim_count": {
          "maximum": 500,
          "minimum": 1,
          "title": "Valid Claim Count",
          "type": "integer"
        },
        "rejected_claim_count": {
          "maximum": 500,
          "minimum": 0,
          "title": "Rejected Claim Count",
          "type": "integer"
        },
        "model_version": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Model Version",
          "type": "string"
        },
        "prompt_version": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Prompt Version",
          "type": "string"
        },
        "validator_version": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Validator Version",
          "type": "string"
        }
      },
      "required": [
        "article_version_id",
        "input_hash",
        "enrichment_id",
        "validation_status",
        "valid_claim_count",
        "rejected_claim_count",
        "model_version",
        "prompt_version",
        "validator_version"
      ],
      "title": "ArticleEnrichedPayload",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "format": "uuid",
      "title": "Event Id",
      "type": "string"
    },
    "event_type": {
      "const": "article.enriched",
      "title": "Event Type",
      "type": "string"
    },
    "event_version": {
      "const": 1,
      "title": "Event Version",
      "type": "integer"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "producer": {
      "const": "ai-content-service",
      "title": "Producer",
      "type": "string"
    },
    "correlation_id": {
      "format": "uuid",
      "title": "Correlation Id",
      "type": "string"
    },
    "causation_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Causation Id"
    },
    "aggregate_type": {
      "const": "article_version",
      "title": "Aggregate Type",
      "type": "string"
    },
    "aggregate_id": {
      "format": "uuid",
      "title": "Aggregate Id",
      "type": "string"
    },
    "idempotency_key": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Idempotency Key",
      "type": "string"
    },
    "payload": {
      "$ref": "#/$defs/ArticleEnrichedPayload"
    }
  },
  "required": [
    "event_id",
    "event_type",
    "event_version",
    "occurred_at",
    "producer",
    "correlation_id",
    "causation_id",
    "aggregate_type",
    "aggregate_id",
    "idempotency_key",
    "payload"
  ],
  "title": "ArticleEnrichedEvent",
  "type": "object"
}
