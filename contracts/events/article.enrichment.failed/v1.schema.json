{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "ArticleEnrichmentFailedPayload": {
      "additionalProperties": false,
      "properties": {
        "article_version_id": {
          "format": "uuid",
          "title": "Article Version Id",
          "type": "string"
        },
        "input_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Input Hash",
          "type": "string"
        },
        "error_code": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "title": "Error Code",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        },
        "attempt": {
          "maximum": 20,
          "minimum": 1,
          "title": "Attempt",
          "type": "integer"
        },
        "model_version": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Model Version",
          "type": "string"
        },
        "prompt_version": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Prompt Version",
          "type": "string"
        }
      },
      "required": [
        "article_version_id",
        "input_hash",
        "error_code",
        "retryable",
        "attempt",
        "model_version",
        "prompt_version"
      ],
      "title": "ArticleEnrichmentFailedPayload",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "format": "uuid",
      "title": "Event Id",
      "type": "string"
    },
    "event_type": {
      "const": "article.enrichment.failed",
      "title": "Event Type",
      "type": "string"
    },
    "event_version": {
      "const": 1,
      "title": "Event Version",
      "type": "integer"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "producer": {
      "const": "ai-content-service",
      "title": "Producer",
      "type": "string"
    },
    "correlation_id": {
      "format": "uuid",
      "title": "Correlation Id",
      "type": "string"
    },
    "causation_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Causation Id"
    },
    "aggregate_type": {
      "const": "article_version",
      "title": "Aggregate Type",
      "type": "string"
    },
    "aggregate_id": {
      "format": "uuid",
      "title": "Aggregate Id",
      "type": "string"
    },
    "idempotency_key": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Idempotency Key",
      "type": "string"
    },
    "payload": {
      "$ref": "#/$defs/ArticleEnrichmentFailedPayload"
    }
  },
  "required": [
    "event_id",
    "event_type",
    "event_version",
    "occurred_at",
    "producer",
    "correlation_id",
    "causation_id",
    "aggregate_type",
    "aggregate_id",
    "idempotency_key",
    "payload"
  ],
  "title": "ArticleEnrichmentFailedEvent",
  "type": "object"
}
