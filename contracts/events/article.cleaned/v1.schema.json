{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "ArticleCleanedPayload": {
      "additionalProperties": false,
      "properties": {
        "source_id": {"format": "uuid", "title": "Source Id", "type": "string"},
        "article_id": {"format": "uuid", "title": "Article Id", "type": "string"},
        "article_version_id": {
          "format": "uuid",
          "title": "Article Version Id",
          "type": "string"
        },
        "canonical_url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Canonical Url",
          "type": "string"
        },
        "title": {"maxLength": 512, "minLength": 1, "title": "Title", "type": "string"},
        "content_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "language": {"const": "en", "title": "Language", "type": "string"},
        "cleaned_at": {"format": "date-time", "title": "Cleaned At", "type": "string"},
        "mongo_collection": {
          "const": "source_articles",
          "title": "Mongo Collection",
          "type": "string"
        },
        "mongo_document_id": {
          "pattern": "^[a-f0-9]{24}$",
          "title": "Mongo Document Id",
          "type": "string"
        },
        "duplicate_type": {
          "enum": ["NONE", "URL", "EXACT", "NEAR"],
          "title": "Duplicate Type",
          "type": "string"
        },
        "duplicate_of_article_version_id": {
          "anyOf": [{"format": "uuid", "type": "string"}, {"type": "null"}],
          "title": "Duplicate Of Article Version Id"
        }
      },
      "required": [
        "source_id",
        "article_id",
        "article_version_id",
        "canonical_url",
        "title",
        "content_hash",
        "language",
        "cleaned_at",
        "mongo_collection",
        "mongo_document_id",
        "duplicate_type",
        "duplicate_of_article_version_id"
      ],
      "title": "ArticleCleanedPayload",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "event_id": {"format": "uuid", "title": "Event Id", "type": "string"},
    "event_type": {"const": "article.cleaned", "title": "Event Type", "type": "string"},
    "event_version": {"const": 1, "title": "Event Version", "type": "integer"},
    "occurred_at": {"format": "date-time", "title": "Occurred At", "type": "string"},
    "producer": {"const": "article-service", "title": "Producer", "type": "string"},
    "correlation_id": {"format": "uuid", "title": "Correlation Id", "type": "string"},
    "causation_id": {
      "anyOf": [{"format": "uuid", "type": "string"}, {"type": "null"}],
      "title": "Causation Id"
    },
    "aggregate_type": {"const": "article_version", "title": "Aggregate Type", "type": "string"},
    "aggregate_id": {"format": "uuid", "title": "Aggregate Id", "type": "string"},
    "idempotency_key": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Idempotency Key",
      "type": "string"
    },
    "payload": {"$ref": "#/$defs/ArticleCleanedPayload"}
  },
  "required": [
    "event_id",
    "event_type",
    "event_version",
    "occurred_at",
    "producer",
    "correlation_id",
    "causation_id",
    "aggregate_type",
    "aggregate_id",
    "idempotency_key",
    "payload"
  ],
  "title": "ArticleCleanedEvent",
  "type": "object"
}
